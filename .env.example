# URL do banco de dados PostgreSQL
# Exemplo Supabase: postgresql://postgres:SENHA@db.abcdef.supabase.co:5432/postgres
DATABASE_URL=sua_url_do_postgresql_aqui

# Token secreto para acessar o painel admin (crie uma senha forte!)
ADMIN_API_TOKEN=sua_senha_secreta_muito_forte_aqui

# ID da aplicacao Discord (do Developer Portal)
DISCORD_CLIENT_ID=1234567890123456789

# Secret da aplicacao Discord (do Developer Portal)
DISCORD_CLIENT_SECRET=seu_client_secret_aqui

# URL publica da sua API (depois do deploy no Render)
# Exemplo: https://mandragora-api.onrender.com
API_URL=https://sua-api-aqui.onrender.com

# URL do seu site (depois do deploy no Cloudflare Pages)
# Exemplo: https://mandragora-guild.pages.dev
FRONTEND_URL=https://seu-site-aqui.pages.dev

# Ambiente
NODE_ENV=production

# Porta (o Render define automaticamente, mas deixe 3000 como padrao)
PORT=3000
